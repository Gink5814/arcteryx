{
  "researched_at": "2026-10-27T04:32:54.360606+00:00",
  "scope": "US/USD only; source-code assessment, not a live compatibility test or installation.",
  "method": "Read maintainer metadata, pinned README/license/dependency files, implementation and relevant tests; no third-party application code executed or copied. Stars/pushdates are descriptive metadata, not correctness evidence.",
  "recommendation": "Use PriceBuddy as the product/function reference; use durable scheduling and health ideas from it and Huginn while preserving our strict variant/provenance model.",
  "projects": [
    {
      "category": "self_hosted_price_tracking_application",
      "license_verified": "GPL-3.0-only (composer.json); GPLv3 text in LICENSE",
      "fit": "Strongest complete price-tracker application inspected here; useful reference, not an exact-variant US Arc'teryx drop-in replacement.",
      "verified_features": [
        {
          "claim": "Has both plain HTTP and browser-backed scrape services; browser service is separate seleniumbase-scrapper container.",
          "source_urls": [
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Enums/ScraperService.php",
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/docker-compose.yml"
          ]
        },
        {
          "claim": "Store-level configurable extraction collects title, description, price, image and availability; this contract does not require SKU, color or size.",
          "source_urls": [
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Services/ScrapeUrl.php"
          ]
        },
        {
          "claim": "Appends price rows associated with URL and store. Current migration uses float; price stats min/max/average calculate an input series, not proof of our daily-low 90/365 semantics.",
          "source_urls": [
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/database/migrations/2025_01_08_040213_create_prices_table.php",
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Models/Url.php",
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Services/Insights/PriceStatsCalculator.php"
          ]
        },
        {
          "claim": "Delayed retry chain defaults to 3 attempts and a 15-minute delay, stops after recovery or pause/deletion, and throttles exhausted-failure notifications across URLs of a product. Queue retry attempts are 1 to avoid duplicate retry chains.",
          "source_urls": [
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Jobs/RetryUrlPriceJob.php",
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/database/settings/2026_06_10_000000_add_scrape_retry_settings.php",
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/tests/Feature/Jobs/RetryUrlPriceJobTest.php"
          ]
        },
        {
          "claim": "Successful dispatch precedes advancing custom next_check_at, so dispatch failure does not silently skip a due product. Per-product jobs pace their scraping via configured sleep.",
          "source_urls": [
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Services/PriceFetcherService.php",
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Jobs/UpdateProductPricesJob.php"
          ]
        },
        {
          "claim": "Scrape retries disable page cache; unreadable amount returns null rather than inserting zero; unavailable product without price keeps previous history.",
          "source_urls": [
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Services/ScrapeUrl.php",
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/app/Models/Url.php"
          ]
        },
        {
          "claim": "Built-in US seed file contains Amazon US and eBay US; no Arc'teryx/REI adapter in that file. Generic support claims were not live-verified on our retailers.",
          "source_urls": [
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/database/seeders/Stores/usa.php"
          ]
        },
        {
          "claim": "PHP 8.4 / Laravel 12 application; recommended compose also runs MySQL 8.2 and a browser scrape service. Heavier operational change than current Python stdlib / SQLite app.",
          "source_urls": [
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/composer.json",
            "https://github.com/jez500/pricebuddy/blob/f606128f5f723b70fe817362954e251c02143745/docker-compose.yml"
          ]
        }
      ],
      "adopt_independent_design": [
        "Persist delayed failure retries and retry state; respect paused watches and bound attempts.",
        "Space requests per source and make exhausted-failure events deduplicated.",
        "Keep independent confirmation reads uncached if a page cache is added later."
      ],
      "do_not_assume": [
        "No live US Arc'teryx or REI validation performed for PriceBuddy.",
        "No pre-monitoring historical price dataset obtained.",
        "No exact manufacturer SKU/color/size match guarantee in inspected generic extraction contract.",
        "Do not copy GPL-3.0-only source into this MIT repository without separately resolving licensing. Only architecture is referenced."
      ],
