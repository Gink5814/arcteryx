    {
      "category": "self_hosted_event_automation_platform",
      "license_verified": "MIT license text read",
      "fit": "Good reference for durable event and job uniqueness; too general to replace our price model directly.",
      "verified_features": [
        {
          "claim": "WebsiteAgent fetches HTML/XML/JSON/text with CSS/XPath/JSON paths or regex extraction and requires row extractors to produce matching counts.",
          "source_urls": [
            "https://github.com/huginn/huginn/blob/2b1eb20cb657b86ca52378c75fc4176a3815c524/app/models/agents/website_agent.rb"
          ]
        },
        {
          "claim": "on_change mode compares complete payloads against bounded previous events, extends matching event expiry rather than creating a duplicate; all/merge modes create each event.",
          "source_urls": [
            "https://github.com/huginn/huginn/blob/2b1eb20cb657b86ca52378c75fc4176a3815c524/app/models/agents/website_agent.rb"
          ]
        },
        {
          "claim": "AgentCheckJob uses per-agent execution locking; opt-in uniqueness_key allows queue duplicate suppression; duplicate enqueue violates DB unique constraint and is converted to explicit enqueue error. Failed job releases uniqueness_key.",
          "source_urls": [
            "https://github.com/huginn/huginn/blob/2b1eb20cb657b86ca52378c75fc4176a3815c524/app/jobs/agent_check_job.rb",
            "https://github.com/huginn/huginn/blob/2b1eb20cb657b86ca52378c75fc4176a3815c524/config/initializers/delayed_job_uniqueness_key.rb",
            "https://github.com/huginn/huginn/blob/2b1eb20cb657b86ca52378c75fc4176a3815c524/spec/initializers/delayed_job_uniqueness_key_spec.rb"
          ]
        },
        {
          "claim": "WebsiteAgent working state uses expected event cadence and absence of recent error logs; this is operational health rather than exact price freshness.",
          "source_urls": [
            "https://github.com/huginn/huginn/blob/2b1eb20cb657b86ca52378c75fc4176a3815c524/app/models/agents/website_agent.rb"
          ]
        },
        {
          "claim": "Ruby >= 3.4 / Rails 8.1 application with delayed_job and database adapter dependencies; reviewed WebsiteAgent uses Faraday and Nokogiri, not a JavaScript browser engine.",
          "source_urls": [
            "https://github.com/huginn/huginn/blob/2b1eb20cb657b86ca52378c75fc4176a3815c524/Gemfile",
            "https://github.com/huginn/huginn/blob/2b1eb20cb657b86ca52378c75fc4176a3815c524/app/models/agents/website_agent.rb"
          ]
        }
      ],
      "adopt_independent_design": [
        "Keep stable identity and database-backed uniqueness for scheduled work, including across restarts/workers.",
        "Distinguish collector health from business price/stock change, and avoid treating unchanged price as failure."
      ],
      "do_not_assume": [
        "Generic extracted events are not a ready normalized price history.",
        "No live retailer, exact variant or historical coverage verification for this project.",
        "Do not simply use change-only event rows as daily coverage evidence."
      ],
